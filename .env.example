PUBLIC_ORIGIN=http://localhost:3000
# Optional. Defaults to the PUBLIC_ORIGIN hostname; may be a valid parent domain.
# WEBAUTHN_RP_ID=example.com
# Defaults to true. Set false to prevent adding another passkey through an authenticator
# that already stores a passkey for the same Hanko account.
WEBAUTHN_ALLOW_MULTIPLE_PASSKEYS_PER_AUTHENTICATOR=true
DATABASE_URL=sqlite://./hanko.sqlite?mode=rwc
# Optional. Exact proxy peer IPs allowed to supply X-Forwarded-For.
# TRUSTED_PROXY_ADDRESSES=10.0.0.10,10.0.0.11
# Required. Generate once and keep stable across restarts: openssl rand -base64 32
IDENTITY_MASTER_KEY=
# Used once, only while the users table is empty, to bootstrap the first administrator.
BOOTSTRAP_TOKEN=
RUST_LOG=hanko=info,tower_http=info
# Optional UI build setting. Comma-separated OIDC claims hidden from user profile forms.
VITE_HIDDEN_USER_CLAIMS=
# Optional runtime setting. Comma-separated user profile fields required during setup and profile updates.
REQUIRED_USER_CLAIMS=
# Consent grants persist until revoked by default. Set a positive number to expire grants after that many seconds.
OIDC_CONSENT_LIFETIME_SECONDS=0
# Optional policy for changes made in the account's OIDC profile. Defaults to false.
OIDC_REVOKE_CONSENTS_ON_IDENTITY_CHANGE=false
OIDC_REVOKE_SESSIONS_ON_IDENTITY_CHANGE=false
