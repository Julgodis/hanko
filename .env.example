PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite://./hanko.sqlite?mode=rwc
# Required. Generate once and keep stable across restarts: openssl rand -base64 32
IDENTITY_MASTER_KEY=
# Used once, only while the users table is empty, to bootstrap the first administrator.
BOOTSTRAP_TOKEN=
RUST_LOG=hanko=info,tower_http=info
